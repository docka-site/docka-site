# Frontend (.env para artifacts/web)
VITE_API_URL=https://[seu-backend-railway].railway.app
PORT=5175
BASE_PATH=/

# Backend (.env para artifacts/api-server)
NODE_ENV=production
PORT=8082
DATABASE_URL=postgresql://[usuario]:[senha]@[host]:5432/docka_seguros
JWT_SECRET=[gerar-com-crypto.randomBytes(32).toString('hex')]

# Email (se usar para notificações)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASSWORD=sua-senha-app

# WhatsApp
WHATSAPP_NUMBER=+55XXXXXXXXXXX
